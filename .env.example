#--- Common ---
# 値はすべて `npx supabase start` 後に `npx supabase status` で表示される
# ローカルインスタンスのものをコピーしてください。
SUPABASE_URL=http://127.0.0.1:54421
# `npx supabase status` の "Secret key" を設定してください（sb_secret_... 形式）
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# `npx supabase status` の "Publishable key" を設定してください（sb_publishable_... 形式）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web側のキャッシュを無効化するためのシークレットキー（任意の文字列）
REVALIDATE_SECRET=your-secret-key-here

#--- AI (Vertex AI Gemini) ---
# 利用する GCP プロジェクト ID
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# Vertex AI のリージョン（東京なら asia-northeast1、米国なら us-central1）
GOOGLE_VERTEX_LOCATION=asia-northeast1
# ローカル開発時のみ: gcloud auth application-default login で発行された認証情報を使う場合は未設定でOK
# サービスアカウントキーを直接使う場合は JSON ファイルパスを指定:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

#--- Web ---
# Basic認証をONにする場合は設定してください
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# AdminサーバーのURLを設定してください
ADMIN_URL=http://localhost:3011
# Langfuse設定（プロンプト管理・LLM監視）任意
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AI Chatの日次コストリミット（USD）
CHAT_DAILY_COST_LIMIT_USD=

# --- Admin ---
# WebサーバーのURLを設定してください
NEXT_PUBLIC_WEB_URL=http://localhost:3010
# AI情報収集で使用するClaude CLIのパス（省略時はPATH上の "claude" を使用）
CLAUDE_CLI_PATH=
