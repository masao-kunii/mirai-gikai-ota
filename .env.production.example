# 本番DBに接続してローカルのAdminを動かす用の環境変数
# このファイルをコピーして .env.production を作成し、本番の値を設定してください
# .env.production は .gitignore で除外されているため、コミットされません
#
# 使い方: pnpm dev:admin:prod-db

#--- Common ---
# Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# AI Chatの日次コストリミット（USD）
CHAT_DAILY_COST_LIMIT_USD=5

# --- Admin ---
NEXT_PUBLIC_WEB_URL=http://localhost:3000
