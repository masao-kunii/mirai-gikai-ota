{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirai-gikai-admin",
  "compatibility_date": "2025-04-01",
  "observability": { "enabled": true },
  // 管理フロントは純 SPA（Vite ビルド）。Worker スクリプトは持たず、
  // ビルド成果物を Static Assets として配信するだけ。クライアントルーティング
  // （TanStack Router）のため、未知のパスは index.html へフォールバックする。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // ルーティングとアクセス制御（本番）:
  //   - 管理用ホスト（例 admin.<zone>）全体を Cloudflare Access の背後に置く。
  //   - admin.<zone>/*     → この Worker（SPA）
  //   - admin.<zone>/api/* → mirai-gikai-api（SPA は相対 /api を叩くため同一オリジンに載せる）
  // Routes は Cloudflare ダッシュボードか infra/（Terraform）で設定する。
  // 詳細は docs/20260801_0758_adminカットオーバー準備.md を参照。
}
