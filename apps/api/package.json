{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "eval": "tsx src/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.mts",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@mirai-gikai/db": "workspace:*",
    "@mirai-gikai/shared": "workspace:*",
    "ai": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "jose": "^6.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260705.1",
    "@hono/node-server": "^2.0.12",
    "@types/node": "^22.5.5",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.111.0"
  },
  "main": "./src/client-types.ts",
  "types": "./src/client-types.ts",
  "exports": {
    ".": {
      "types": "./src/client-types.ts",
      "default": "./src/client-types.ts"
    }
  }
}
